# sdkconfig.defaults — applied to all envs

# ── Chip revision — required for ESP32-P4 v1.0 (ECO2) ────────
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_1=y

# ── PSRAM ─────────────────────────────────────────────────────
# RE-TESTING AGAIN 2026-07-12, THIRD TIME: user recalled (from a lost
# session) that an earlier "200MHz hang" report may have been a
# measurement error — the DQS calibration retry loop can take ~100
# iterations / 5+ seconds of visible "set to best phase" print spam
# before genuinely completing and continuing to boot successfully. A
# short capture window (10s, used in this session's most recent retest)
# would show exactly that spam and could easily be misread as a
# permanent hang. Retesting with a much longer capture window (60-90s+)
# before concluding anything this time. Previous config-completeness
# gaps (missing CONFIG_SPIRAM_XIP_FROM_PSRAM, tested on a debug not
# perf-optimized build) also still apply and haven't been addressed yet
# — see CONTEXT.md for the full, corrected history of this back-and-forth
# (do not trust any single "confirmed broken" claim in an older section
# without checking for a later correction).
# TEMPORARILY BACK TO 20MHz 2026-07-13 while root-causing a deterministic
# (10/10) xTaskCreateStaticPinnedToCore/xPortcheckValidStackMem crash at
# scheduler start, specific to CONFIG_SPIRAM_SPEED_200M — confirmed NOT
# caused by tuning duration (cut delayline repeats 100->8, no change) or
# by L2 cache line size/capacity (tested both Waveshare's 256KB/128B and
# ESP-IDF defaults, no change). Actively investigating — see CONTEXT.md
# "2026-07-13" section for the full trace. Flip CONFIG_SPIRAM_SPEED_200M
# + CONFIG_IDF_EXPERIMENTAL_FEATURES back on to resume that work; don't
# leave the board sitting in the crash-reboot loop when not actively
# testing it.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
# (No true middle speed exists for ESP32-P4 in this ESP-IDF version —
# Kconfig only offers 20M or 200M. See CONTEXT.md for the DMA-underrun
# investigation this was trying to fix — root cause of blank display,
# separate from PSRAM speed, see "single frame" test and the 2026-07-12
# GDMA-feed findings.)

# ── Flash ─────────────────────────────────────────────────────
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# ── FreeRTOS ──────────────────────────────────────────────────
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240

# ── Logging ───────────────────────────────────────────────────
CONFIG_LOG_DEFAULT_LEVEL_DEBUG=y
CONFIG_LOG_DEFAULT_LEVEL=4

# ── WiFi remote EAP — disable to avoid build errors ──────────
CONFIG_ESP_WIFI_REMOTE_EAP_ENABLED=n

# ── WiFi buffers ──────────────────────────────────────────────
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=1
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_RX_MGMT_BUF=y
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=5
CONFIG_ESP_WIFI_ESPNOW_MAX_ENCRYPT_NUM=7

# ── OTA / app rollback ────────────────────────────────────────
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ── HTTP server ───────────────────────────────────────────────
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_HTTPD_TASK_STACK_SIZE=8192

# ── LVGL — use lv_conf.h instead of Kconfig ──────────────────
CONFIG_LV_CONF_SKIP=n

# ── ESP-Hosted (ESP32-P4-Nano: P4 host + C6 slave via SDIO) ──
# P4-Nano uses SDIO not SPI for P4-to-C6 communication.
# Confirmed from schematic: GPIO14-19 are SDIO signals.
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_GPIO_HANDSHAKE=16
CONFIG_ESP_HOSTED_GPIO_DATA_READY=17
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
