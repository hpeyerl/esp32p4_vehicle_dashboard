// SPDX-License-Identifier: BSD-3-Clause
/*
 * Waveshare 12.3" DSI-TOUCH-A (Himax HX8399-C) on Radxa CM3 (RK3566) / CM4IO DISP1.
 *
 * COMPLETE overlay. SoC-side plumbing lifted verbatim from the shipped
 * `radxa-cm3-rpi-cm4-7inch-touchscreen-disp1.dtbo` (same board/connector); panel
 * swapped for ours. Everything routes VP0 -> dsi1 (disabling HDMI-on-vp0), enables
 * the DSI DPHY (video_phy1) and i2c0.
 *
 * PANEL POWER/RESET/BACKLIGHT = `rockpi_mcu@0x45` (built-in BSP driver). Verified
 * LIVE 2026-08-13 that the panel MCU is byte-identical to our Waveshare part
 * (hw id=0x01, size=123, GPIO-expander regs 0x94/0x95, PWM 0x96) and that driving
 * it lights the backlight — so the panel node carries NO reset/power/backlight gpios.
 * If rockpi_mcu doesn't fully power/reset our panel, fall back to our proven i2cset
 * sequence (src/waveshare_display.c prv_mcu_panel_power_on) as a boot oneshot.
 *
 * Touch (GT911@0x5d) intentionally OMITTED here — add once video is confirmed.
 *
 * Native 720x1920 portrait, 4-lane, RGB888; UI is 1920x720 rotated 270 in fbdev.
 * Pre-merge into the base DTB with fdtoverlay (NOT U-Boot fdtoverlays — that traps
 * into rescue on this board). See linux/cm3/README.md + project_cm3_can_dts memory.
 */
/dts-v1/;
/plugin/;

/* No dt-bindings includes: all values below are numeric (mipi-dsi.h isn't in the
   BSP kernel headers, and the panel node uses no gpios). */

&dsi1 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	panel@0 {
		compatible = "simple-panel-dsi", "panel-simple-dsi";
		reg = <0>;

		/*
		 * dsi,flags = 0xa03 = the Radxa/Rockchip convention for these DSI
		 * panels: MIPI_DSI_MODE_VIDEO | _VIDEO_BURST | _NO_EOT_PACKET | _LPM.
		 * (Numeric to avoid the EOT-flag-polarity ambiguity across kernel
		 * versions; matches what the shipped Radxa DSI overlays use.)
		 */
		dsi,flags  = <0xa03>;
		dsi,format = <0>;	/* MIPI_DSI_FMT_RGB888 */
		dsi,lanes  = <4>;

		/include/ "hx8399-init-seq.dtsi"
		panel-exit-sequence = [
			05 0a 01 28	/* DISPOFF +10ms */
			05 78 01 10	/* SLPIN   +120ms */
		];

		display-timings {
			native-mode = <&ws_timing0>;
			/* 95 MHz => ~63 Hz (panel native, what the Pi runs). Porches from
			   the Pi driver. 80 MHz/~53 Hz is the proven fallback if the VOP/DSI
			   PLL can't make 95. */
			ws_timing0: timing0 {
				clock-frequency = <95000000>;
				hactive      = <720>;
				vactive      = <1920>;
				hsync-len    = <10>;
				hback-porch  = <12>;
				hfront-porch = <10>;
				vsync-len    = <18>;
				vback-porch  = <4>;
				vfront-porch = <64>;
				hsync-active = <0>;
				vsync-active = <0>;
				de-active    = <0>;
				pixelclk-active = <0>;
			};
		};

		ports {
			#address-cells = <1>;
			#size-cells = <0>;
			port@0 {
				reg = <0>;
				ws_panel_in: endpoint {
					remote-endpoint = <&ws_dsi1_out>;
				};
			};
		};
	};

	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;
			ws_dsi1_out: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&ws_panel_in>;
			};
		};
	};
};

/*
 * Panel MCU (power/reset/backlight) on i2c0.
 * GT911 touch deliberately NOT bound to a kernel driver: the Rockchip BSP Goodix-TS
 * driver hard-requires touch-INT + reset GPIOs that this CM4IO DISP1 connector doesn't
 * expose (they're MCU-mediated) -> it logs "invalid GPIO -2", its i2c reads fail (-6),
 * and it loops "Process reset" — spamming i2c-0 (shared with the MCU). Backed out
 * 2026-08-17. Touch, if wanted later, = a userspace GT911 reader in the app over i2c.
 */
&i2c0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_xfer>;
	#address-cells = <1>;
	#size-cells = <0>;

	rockpi-mcu@45 {
		compatible = "rockpi_mcu";
		reg = <0x45>;
	};
};

/* VOP2 VP0 -> dsi1 route (takes VP0 from HDMI). */
&dsi1_in_vp0 {
	status = "okay";
};

&route_dsi1 {
	status = "okay";
	connect = <&vp0_out_dsi1>;
};

&hdmi {
	status = "disabled";
};

&hdmi_in_vp0 {
	status = "disabled";
};

/* DSI DPHY for dsi1. */
&video_phy1 {
	status = "okay";
};
