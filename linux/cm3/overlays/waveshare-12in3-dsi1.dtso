// SPDX-License-Identifier: BSD-3-Clause
/*
 * Waveshare 12.3" DSI-TOUCH-A (Himax HX8399-C) on Radxa CM3 (RK3566) / CM4IO.
 *
 * Panel node fully specified from our proven config (init-sequence generated by
 * gen_panel_init_seq.py from src/waveshare_display.c == the Pi's
 * panel-waveshare-dsi-v2.c ws_panel_12_3_a_4lane_init). The *board plumbing* is
 * marked TODO — it needs the CM3-on-CM4IO DT + the panel's reset/backlight wiring.
 *
 * Native: 720x1920 portrait, 4-lane, RGB888. The UI is 1920x720 landscape and is
 * rotated 270 in software (fbdev) as on the Pi — see linux/cm3/README.md.
 *
 * Build (Radxa overlay flow, cpp + dtc): the .dtsi is pulled in with /include/.
 */
/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/display/mipi-dsi.h>

&{/} {
	compatible = "radxa,cm3-io", "rockchip,rk3566";
};

/*
 * TODO: confirm which RK3566 DSI controller is routed to the CM4IO DISP1 (4-lane)
 * connector on the CM3. DISP0 on the CM4IO is 2-lane-only (established during the
 * P4 saga). Likely &dsi1; verify against the Radxa CM3 CM4IO DTS.
 */
&dsi1 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	panel@0 {
		compatible = "simple-panel-dsi", "panel-simple-dsi";
		reg = <0>;

		dsi,flags = <(MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
			      MIPI_DSI_MODE_LPM | MIPI_DSI_MODE_EOT_PACKET)>;
		dsi,format = <MIPI_DSI_FMT_RGB888>;
		dsi,lanes  = <4>;

		/* --- TODO: board wiring (fill from the HAT / CM4IO routing) --- */
		reset-gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;   /* panel LCD_RESET */
		/* backlight   = <&backlight>; */           /* if BL is PWM/GPIO gated */
		/* power-supply = <&vcc3v3_lcd>; */

		/* init sequence — regenerate with gen_panel_init_seq.py */
		/include/ "hx8399-init-seq.dtsi"
		panel-exit-sequence = [
			05 0a 01 28	/* DISPOFF +10ms */
			05 78 01 10	/* SLPIN   +120ms */
		];

		disp_timings0: display-timings {
			native-mode = <&dsi_timing0>;
			/*
			 * ~95 MHz => ~63 Hz (panel native, what the Pi runs).
			 * 80 MHz => ~53 Hz is also proven-good if the VOP/DSI PLL
			 * prefers it. Porches are from the Pi driver.
			 */
			dsi_timing0: timing0 {
				clock-frequency = <95000000>;
				hactive      = <720>;
				vactive      = <1920>;
				hsync-len    = <10>;
				hback-porch  = <12>;
				hfront-porch = <10>;
				vsync-len    = <18>;
				vback-porch  = <4>;
				vfront-porch = <64>;
				hsync-active = <0>;
				vsync-active = <0>;
				de-active    = <0>;
				pixelclk-active = <0>;
			};
		};

		port {
			panel_in_dsi: endpoint {
				remote-endpoint = <&dsi1_out_panel>;
			};
		};
	};

	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		port@1 {
			reg = <1>;
			dsi1_out_panel: endpoint {
				remote-endpoint = <&panel_in_dsi>;
			};
		};
	};
};

/*
 * TODO: enable the VOP2 -> DSI route. On RK3566 rockchip-drm this is a
 * vp<->dsi endpoint link (e.g. &vop, route_dsi1, vp1). The exact node names
 * depend on the Radxa CM3 base DTS. See README "Display".
 */
