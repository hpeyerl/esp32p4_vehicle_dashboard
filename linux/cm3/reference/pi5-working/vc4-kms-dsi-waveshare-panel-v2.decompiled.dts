				reset-gpio = <0x01 0x01 0x00>;
				iovcc-gpio = <0x01 0x04 0x00>;
				avdd-gpio = <0x01 0x00 0x00>;
				backlight = <0x01>;
				phandle = <0x04>;

				port {

					endpoint {
						remote-endpoint = <0x03>;
						phandle = <0x02>;
					};
				};
			};
		};
	};

	fragment@2 {
