/dts-v1/;

/ {
	compatible = "brcm,bcm2835";

	fragment@0 {
		target = <0xffffffff>;
		phandle = <0x07>;

		__overlay__ {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "okay";

			display_mcu@45 {
				compatible = "waveshare,touchscreen-panel-regulator";
				reg = <0x45>;
				gpio-controller;
				#gpio-cells = <0x02>;
				enable-gpio = <0x01 0x02 0x00>;
				phandle = <0x01>;
			};

			goodix@5d {
				compatible = "goodix,gt9271";
				reg = <0x5d>;
				reset-gpio = <0x01 0x09 0x00>;
				phandle = <0x05>;
			};
		};
	};

