#!/bin/sh
# systemd-sleep hook: work around brcmfmac SDIO wifi failing to resume from STR
# (brcmf_ops_sdio_resume: Failed to probe device on resume, -123 / -ENOMEDIUM).
# Unload the driver before suspend and reload it after resume so wifi comes back.
# Placed in /lib/systemd/system-sleep/ ; systemd runs it as: <script> pre|post <mode>.
case "$1/$2" in
  pre/*)
    /usr/sbin/rmmod brcmfmac 2>/dev/null || true
    ;;
  post/*)
    /usr/sbin/modprobe brcmfmac 2>/dev/null || true
    ;;
esac
exit 0
