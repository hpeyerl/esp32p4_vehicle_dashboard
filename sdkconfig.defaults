# sdkconfig.defaults — applied to all envs

# ── Chip revision — required for ESP32-P4 v1.0 (ECO2) ────────
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_1=y

# ── PSRAM ─────────────────────────────────────────────────────
# CONFIG_SPIRAM_SPEED_200M is non-deterministic on this board: a fresh
# power-on sometimes calibrates fine, sometimes hangs forever in an infinite
# "set to best phase: 0" DQS retry loop, regardless of L2 cache size. Not
# shippable. Turns out PSRAM speed was never the real bug anyway — see
# waveshare_display.c for the actual fix (DSI command-sequencing, not
# bandwidth). Stick with the stable 20MHz default.
CONFIG_SPIRAM=y

# ── Flash ─────────────────────────────────────────────────────
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# ── FreeRTOS ──────────────────────────────────────────────────
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240

# ── Logging ───────────────────────────────────────────────────
CONFIG_LOG_DEFAULT_LEVEL_DEBUG=y
CONFIG_LOG_DEFAULT_LEVEL=4

# ── WiFi remote EAP — disable to avoid build errors ──────────
CONFIG_ESP_WIFI_REMOTE_EAP_ENABLED=n

# ── WiFi buffers ──────────────────────────────────────────────
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=1
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_RX_MGMT_BUF=y
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=5
CONFIG_ESP_WIFI_ESPNOW_MAX_ENCRYPT_NUM=7

# ── OTA / app rollback ────────────────────────────────────────
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ── HTTP server ───────────────────────────────────────────────
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_HTTPD_TASK_STACK_SIZE=8192

# ── LVGL — use lv_conf.h instead of Kconfig ──────────────────
CONFIG_LV_CONF_SKIP=n

# ── ESP-Hosted (ESP32-P4-Nano: P4 host + C6 slave via SDIO) ──
# P4-Nano uses SDIO not SPI for P4-to-C6 communication.
# Confirmed from schematic: GPIO14-19 are SDIO signals.
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_GPIO_HANDSHAKE=16
CONFIG_ESP_HOSTED_GPIO_DATA_READY=17
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
